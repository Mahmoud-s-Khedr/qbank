# Copy to .env.prod and protect it (chmod 600). Use URL-safe random values:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
QBANK_DOMAIN=school.example.org
POSTGRES_PASSWORD=
QBANK_ENV=prod
QBANK_JWT_SECRET=
QBANK_COOKIE_SECURE=true
QBANK_S3_ENDPOINT_URL=http://minio:9000
QBANK_S3_BUCKET=qbank
QBANK_S3_ACCESS_KEY=
QBANK_S3_SECRET_KEY=
QBANK_STORAGE_BACKEND=s3
# Put a funded OpenRouter key here and set its provider-side spending limit.
QBANK_OPENROUTER_API_KEY=
QBANK_LLM_MODE=live
QBANK_LLM_BUDGET_USD=0.50
QBANK_LLM_MAX_PRICE_IN_PER_M=1.0
QBANK_LLM_MAX_PRICE_OUT_PER_M=5.0
QBANK_MAX_PAGES=1000
QBANK_MAX_UPLOAD_MB=300
QBANK_LOG_LEVEL=INFO
QBANK_SESSION_TTL_MINUTES=720
QBANK_RATE_LOGIN_IP=50
QBANK_RATE_LOGIN_EMAIL=10
QBANK_RATE_LOGIN_WINDOW=900
QBANK_RATE_UPLOAD=20
QBANK_RATE_AI=30
QBANK_RATE_USER_WINDOW=3600
# Set COMPOSE_PROFILES=minio for bundled MinIO; omit for external S3.
COMPOSE_PROFILES=minio
API_WORKERS=2
WORKER_REPLICAS=1
WORKER_PROCESSES=2
WORKER_THREADS=4
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Optional tuning defaults (uncomment to override).
# QBANK_CORS_ORIGINS=["https://school.example.org"]
# QBANK_STORAGE_LOCAL_ROOT=./storage
# QBANK_WORKER_CACHE_DIR=/tmp/qbank-cache
# QBANK_WORKER_CACHE_MAX_MB=2048
# QBANK_RENDER_BATCH_SIZE=8
# QBANK_EXTRACT_IMAGE_MAX_SIDE=1600
# QBANK_EXTRACT_FALLBACK_THRESHOLD=0.5
# QBANK_REVIEW_THRESHOLD=0.75
# QBANK_RENDER_DPI_DISPLAY=150
# QBANK_RENDER_DPI_HIRES=300
# QBANK_SSE_INTERVAL=1.0
# QBANK_EXPORT_CHROMIUM_PATH=/path/to/chromium
# QBANK_EXPORT_TIMEOUT_S=60
# QBANK_EXPORT_CHROMIUM_SANDBOX=true
# QBANK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# QBANK_LLM_TIMEOUT_S=120
# QBANK_LLM_MAX_RETRIES=3
# QBANK_LLM_ALLOWED_MODELS=["google/gemini-3.8-flash","qwen/qwen3.8-flash","openai/gpt-6-luna","anthropic/claude-haiku-5.5","nvidia/nemotron-3.5-super-vl:free"]
# QBANK_LLM_STAGE_MODELS is an optional JSON mapping; see .env.example.
# QBANK_DATABASE_URL, QBANK_REDIS_URL, and QBANK_TRUSTED_PROXIES are set by Compose.
