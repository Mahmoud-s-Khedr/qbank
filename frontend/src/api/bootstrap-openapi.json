{
  "openapi": "3.1.0",
  "info": {
    "title": "Qbank API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_check_api_v1_health_get",
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "title": "HealthOut",
        "type": "object",
        "required": ["status", "version", "db"],
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "db": {
            "type": "string",
            "enum": ["ok", "down"],
            "title": "Db"
          }
        }
      }
    }
  }
}
