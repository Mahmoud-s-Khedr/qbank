QBANK_ENV=dev
QBANK_DATABASE_URL=postgresql+psycopg://qbank:qbank@localhost:25432/qbank
QBANK_REDIS_URL=redis://localhost:26379/0
QBANK_S3_ENDPOINT_URL=http://localhost:29000
QBANK_S3_BUCKET=qbank
QBANK_S3_ACCESS_KEY=qbanklocal
QBANK_S3_SECRET_KEY=qbanklocalpassword
QBANK_OPENROUTER_API_KEY=
QBANK_JWT_SECRET=local-development-only-not-for-production
QBANK_CORS_ORIGINS=["http://localhost:5173"]
QBANK_COOKIE_SECURE=false
QBANK_SESSION_TTL_MINUTES=720

QBANK_STORAGE_BACKEND=s3
QBANK_STORAGE_LOCAL_ROOT=./storage
QBANK_MAX_PAGES=1000
QBANK_MAX_UPLOAD_MB=300
QBANK_RENDER_DPI_DISPLAY=150
QBANK_RENDER_DPI_HIRES=300
QBANK_SSE_INTERVAL=1.0

# QBANK_WORKER_CACHE_DIR=/path/to/cache
QBANK_WORKER_CACHE_MAX_MB=2048
QBANK_RENDER_BATCH_SIZE=8
QBANK_EXTRACT_IMAGE_MAX_SIDE=1600
QBANK_EXTRACT_FALLBACK_THRESHOLD=0.5
QBANK_REVIEW_THRESHOLD=0.75

QBANK_LLM_MODE=live
# Deterministic e2e mode: QBANK_LLM_MODE=fake plus a JSON script {stage: [response, ...]}
# QBANK_LLM_FAKE_SCRIPT=scripts/e2e/fake_llm.json
QBANK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QBANK_LLM_TIMEOUT_S=120
QBANK_LLM_MAX_RETRIES=3
QBANK_LLM_MAX_PRICE_IN_PER_M=1.0
QBANK_LLM_MAX_PRICE_OUT_PER_M=5.0
QBANK_LLM_BUDGET_USD=0.50
QBANK_LLM_ALLOWED_MODELS=["google/gemini-3.8-flash","qwen/qwen3.8-flash","openai/gpt-6-luna","anthropic/claude-haiku-5.5","nvidia/nemotron-3.5-super-vl:free"]
QBANK_LLM_STAGE_MODELS={"extract":{"model":"google/gemini-3.8-flash","max_tokens":4096,"reasoning":"off","temperature":0},"extract_strong":{"model":"google/gemini-3.8-flash","max_tokens":4096,"reasoning":"low","temperature":0},"eval":{"model":"google/gemini-3.8-flash","max_tokens":4096,"reasoning":"off","temperature":0},"verify":{"model":"openai/gpt-6-luna","max_tokens":4096,"reasoning":"off","temperature":0},"structure":{"model":"anthropic/claude-haiku-5.5","max_tokens":4096,"reasoning":"off","temperature":0},"classify":{"model":"anthropic/claude-haiku-5.5","max_tokens":4096,"reasoning":"off","temperature":0},"compose":{"model":"anthropic/claude-haiku-5.5","max_tokens":4096,"reasoning":"off","temperature":0}}

# PDF export: path to a Chromium/Chrome binary (default: the browser installed by `playwright install chromium`)
# QBANK_EXPORT_CHROMIUM_PATH=/usr/bin/google-chrome
QBANK_EXPORT_TIMEOUT_S=60
# Set to false only in containers where Chromium's sandbox cannot start (adds --no-sandbox).
QBANK_EXPORT_CHROMIUM_SANDBOX=true
