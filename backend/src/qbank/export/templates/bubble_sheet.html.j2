{% extends "base.html.j2" %}
{% block style %}
<style>
h1 { font-size: 1.3em; text-align: center; }
.info { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm 8mm; margin-block: 4mm; }
.info .field { display: flex; align-items: flex-end; gap: 2mm; white-space: nowrap; }
.info .field i { flex: 1; border-bottom: 1px solid var(--ink); height: 1.3em; }
.hint { text-align: center; font-size: 0.85em; color: var(--soft); margin-bottom: 4mm; }
.rows { column-count: {{ 3 if view.questions|length > 40 else 2 }}; column-gap: 10mm; }
.row { display: flex; align-items: center; gap: 2mm; break-inside: avoid; height: 9mm; }
.row .n { width: 2.2em; text-align: end; font-weight: 700; }
.bubble { display: inline-flex; align-items: center; justify-content: center; width: 6.2mm; height: 6.2mm; border: 1.2px solid var(--ink); border-radius: 50%; font-size: 0.65em; line-height: 1; }
</style>
{% endblock %}
{% block body %}
<h1>{{ t.bubble_title }} — {{ view.header.exam_title }}</h1>
<div class="info">
  <div class="field"><span>{{ t.student_name }}:</span><i></i></div>
  <div class="field"><span>{{ t.student_number }}:</span><i></i></div>
  <div class="field"><span>{{ t.class }}:</span><i></i></div>
  <div class="field"><span>{{ t.version }}:</span><b>{{ view.version_label }}</b></div>
</div>
<div class="hint">{{ t.bubble_hint }}</div>
<div class="rows">
{% for q in view.questions %}
  <div class="row"><span class="n">{{ d(q.number) }}</span>{% for c in q.choices %}<span class="bubble">{{ c.label }}</span>{% endfor %}</div>
{% endfor %}
</div>
{% endblock %}
